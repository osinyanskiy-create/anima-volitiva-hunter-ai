\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1055 \u1110 \u1076 \u1075 \u1086 \u1090 \u1086 \u1074 \u1082 \u1072 : \u1054 \u1094 \u1110 \u1085 \u1082 \u1072  \u1058 \u1056 \u1058  \u1079 \u1086 \u1074 \u1085 \u1110  (\u1110 \u1085 \u1092 \u1088 \u1072 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1072 , \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1080 ) \u1090 \u1072  \u1074 \u1089 \u1077 \u1088 \u1077 \u1076 \u1080 \u1085 \u1110  (\u1087 \u1086 \u1090 \u1077 \u1085 \u1094 \u1110 \u1072 \u1083 , \u1110 \u1085 \u1096 \u1110  \u1090 \u1086 \u1074 \u1072 \u1088 \u1080 , \u1085 \u1072 \u1089 \u1090 \u1088 \u1110 \u1081  \u1087 \u1088 \u1086 \u1076 \u1072 \u1074 \u1094 \u1103 ).\\n\u1062 \u1110 \u1083 \u1100  \u1074 \u1110 \u1079 \u1080 \u1090 \u1091 : \u1042 \u1080 \u1103 \u1074 \u1080 \u1090 \u1080  \u1051 \u1055 \u1056 , \u1076 \u1086 \u1084 \u1086 \u1074 \u1080 \u1090 \u1080 \u1089 \u1103  \u1087 \u1088 \u1086  \u1079 \u1091 \u1089 \u1090 \u1088 \u1110 \u1095 /\u1087 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1110 \u1102 .\\n\u1057 \u1087 \u1110 \u1083 \u1082 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1079  \u1051 \u1055 \u1056 : \u1044 \u1086 \u1085 \u1077 \u1089 \u1090 \u1080 , \u1093 \u1090 \u1086  \u1084 \u1080  (\u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1085 \u1072 \u1081 \u1074 \u1080 \u1097 \u1086 \u1111  \u1103 \u1082 \u1086 \u1089 \u1090 \u1110  \u1079 \u1072  \u1085 \u1080 \u1078 \u1095 \u1091  \u1094 \u1110 \u1085 \u1091 , \u1089 \u1077 \u1088 \u1074 \u1110 \u1089  24/7). \u1044 \u1072 \u1090 \u1080  \u1087 \u1110 \u1076 \u1090 \u1074 \u1077 \u1088 \u1076 \u1078 \u1077 \u1085 \u1085 \u1103  (\u1079  \u1082 \u1080 \u1084  \u1087 \u1088 \u1072 \u1094 \u1102 \u1108 \u1084 \u1086 ). \u1044 \u1086 \u1084 \u1086 \u1074 \u1080 \u1090 \u1080 \u1089 \u1103  \u1087 \u1088 \u1086  \u1087 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1110 \u1102  \u1079  \u1076 \u1077 \u1075 \u1091 \u1089 \u1090 \u1072 \u1094 \u1110 \u1108 \u1102 .\\n\u1055 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1110 \u1103 : \u1042 \u1087 \u1077 \u1074 \u1085 \u1077 \u1085 \u1110 \u1089 \u1090 \u1100 , \u1087 \u1086 \u1089 \u1084 \u1110 \u1096 \u1082 \u1072 . \u1042 \u1080 \u1103 \u1074 \u1080 \u1090 \u1080  \u1074 \u1087 \u1086 \u1076 \u1086 \u1073 \u1072 \u1085 \u1085 \u1103 . \u1056 \u1086 \u1073 \u1080 \u1084 \u1086  \u1082 \u1072 \u1074 \u1091  \u1110  \u1076 \u1072 \u1108 \u1084 \u1086  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1091  (\'ab\u1053 \u1040 !\'bb). \u1055 \u1088 \u1086 \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 \u1108 \u1084 \u1086  \u1088 \u1110 \u1079 \u1085 \u1080 \u1094 \u1102  \u1074  \u1094 \u1110 \u1085 \u1110  \u1090 \u1072  \u1103 \u1082 \u1086 \u1089 \u1090 \u1110 . \u1057 \u1087 \u1086 \u1095 \u1072 \u1090 \u1082 \u1091  \u1074 \u1086 \u1076 \u1072 , \u1087 \u1086 \u1090 \u1110 \u1084  \u1082 \u1072 \u1074 \u1072 .\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103 : \'ab\u1052 \u1077 \u1085 \u1077  \u1074 \u1089 \u1077  \u1074 \u1083 \u1072 \u1096 \u1090 \u1086 \u1074 \u1091 \u1108 \'bb -> \'ab\u1040  \u1097 \u1086  \u1103 \u1082 \u1097 \u1086  \u1103  \u1087 \u1086 \u1082 \u1072 \u1078 \u1091  \u1097 \u1077  \u1082 \u1088 \u1072 \u1097 \u1077 ?\'bb. \'ab\u1041 \u1083 \u1080 \u1079 \u1100 \u1082 \u1110  \u1089 \u1090 \u1086 \u1089 \u1091 \u1085 \u1082 \u1080  \u1079  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1072 \u1084 \u1080 \'bb -> \'ab\u1055 \u1086 \u1082 \u1091 \u1087 \u1077 \u1094 \u1100  \u1074 \u1080 \u1073 \u1080 \u1088 \u1072 \u1108 , \u1084 \u1080  \u1076 \u1073 \u1072 \u1108 \u1084 \u1086  \u1087 \u1088 \u1086  \u1081 \u1086 \u1075 \u1086  \u1074 \u1080 \u1073 \u1110 \u1088 \'bb. \'ab\u1057 \u1077 \u1085 \u1089 \u1086 \u1088 \u1085 \u1080 \u1081  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090 \'bb -> \'ab\u1043 \u1086 \u1083 \u1086 \u1074 \u1085 \u1077  \u1090 \u1077 , \u1097 \u1086  \u1074  \u1095 \u1072 \u1096 \u1094 \u1110 \'bb.\\n\u1071 \u1082 \u1097 \u1086  \u1089 \u1091 \u1084 \u1085 \u1110 \u1074 \u1080 : \u1047 \u1072 \u1087 \u1080 \u1090 \u1091 \u1074 \u1072 \u1090 \u1080  \u1087 \u1088 \u1103 \u1084 \u1086  (\'ab\u1065 \u1086  \u1089 \u1090 \u1088 \u1080 \u1084 \u1091 \u1108 ?\'bb). \u1055 \u1088 \u1086 \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 \u1080  \u1091 \u1084 \u1086 \u1074 \u1080  \'ab\u1087 \u1086  \u1082 \u1110 \u1083 \u1086 \u1075 \u1088 \u1072 \u1084 \u1072 \u1093 \'bb, \u1089 \u1086 \u1073 \u1110 \u1074 \u1072 \u1088 \u1090 \u1110 \u1089 \u1090 \u1100 .\\n\u1047 \u1072 \u1074 \u1077 \u1088 \u1096 \u1077 \u1085 \u1085 \u1103 : \u1041 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1086 \u1102  \u1094 \u1110 \u1085 \u1086 \u1102  \u1079 \u1072 \u1083 \u1080 \u1096 \u1072 \u1108 \u1084 \u1086  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103  \u1085 \u1072  100%. \u1056 \u1086 \u1073 \u1080 \u1084 \u1086  \u1092 \u1110 \u1079 -\u1086 \u1073 \u1084 \u1110 \u1085  \u1082 \u1072 \u1074 \u1080  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1110 \u1074  (\u1079 \u1072 \u1073 \u1080 \u1088 \u1072 \u1108 \u1084 \u1086  \u1079 \u1072 \u1083 \u1080 \u1096 \u1082 \u1080 ). \u1047 \u1072 \u1083 \u1091 \u1095 \u1080 \u1090 \u1080 \u1089 \u1103  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1082 \u1086 \u1102  \u1087 \u1088 \u1086 \u1076 \u1072 \u1074 \u1094 \u1103  (\u1087 \u1088 \u1080 \u1075 \u1086 \u1089 \u1090 \u1080 \u1090 \u1080 ).\\n\u1071 \u1082 \u1097 \u1086  \u1085 \u1077  \u1089 \u1090 \u1072 \u1074 \u1080 \u1084 \u1086  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090 : \u1047 \u1072 \u1083 \u1091 \u1095 \u1080 \u1090 \u1080  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1082 \u1091  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1110 \u1074 , \u1087 \u1088 \u1080 \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 \u1080  \u1085 \u1072 \u1089 \u1090 \u1091 \u1087 \u1085 \u1091  \u1079 \u1091 \u1089 \u1090 \u1088 \u1110 \u1095 , \u1087 \u1086 \u1087 \u1077 \u1088 \u1077 \u1076 \u1080 \u1090 \u1080  \u1085 \u1077  \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1087 \u1110 \u1096 \u1085 \u1080 \u1093  \u1074 \u1080 \u1089 \u1085 \u1086 \u1074 \u1082 \u1110 \u1074 ."\cf0 \cb1 \strokec3 \
