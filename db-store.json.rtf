\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1054 \u1089 \u1085 \u1086 \u1074 \u1085 \u1080 \u1081  \u1087 \u1088 \u1080 \u1085 \u1094 \u1080 \u1087  \u1090 \u1072  \u1087 \u1110 \u1076 \u1093 \u1110 \u1076  \u1074  \u1094 \u1110 \u1085 \u1086 \u1091 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1085 \u1110  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1110 \u1074  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1111  - \u1108  \u1074 \u1080 \u1089 \u1086 \u1082 \u1072  \u1103 \u1082 \u1110 \u1089 \u1090 \u1100  \u1082 \u1072 \u1074 \u1086 \u1074 \u1080 \u1093  \u1085 \u1072 \u1087 \u1086 \u1111 \u1074 , \u1073 \u1077 \u1079 \u1076 \u1086 \u1075 \u1072 \u1085 \u1085 \u1080 \u1081  \u1089 \u1077 \u1088 \u1074 \u1110 \u1089 , \u1087 \u1088 \u1080  \u1094 \u1110 \u1085 \u1072 \u1093 , \u1097 \u1086  \u1085 \u1077  \u1108  \u1074 \u1080 \u1097 \u1080 \u1084 \u1080  \u1074 \u1110 \u1076  \u1087 \u1088 \u1103 \u1084 \u1080 \u1093  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1110 \u1074 . \u1042  \u1076 \u1072 \u1085 \u1086 \u1084 \u1091  \u1083 \u1080 \u1089 \u1090 \u1110  \u1086 \u1087 \u1080 \u1089 \u1072 \u1085 \u1110  3 \u1086 \u1089 \u1085 \u1086 \u1074 \u1085 \u1110  \u1082 \u1072 \u1090 \u1077 \u1075 \u1086 \u1088 \u1110 \u1111  (\u1090 \u1080 \u1087 \u1080 ) \u1094 \u1110 \u1085  \u1076 \u1083 \u1103  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1110 \u1074  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1111 : GOLD, PLATINUM, BLACK, BLACK (water).\\nGOLD - \u1094 \u1077  \u1089 \u1090 \u1072 \u1085 \u1076 \u1072 \u1088 \u1090 \u1085 \u1110  \u1091 \u1084 \u1086 \u1074 \u1080  \u1089 \u1087 \u1110 \u1074 \u1087 \u1088 \u1072 \u1094 \u1110 . \u1042 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1102 \u1108 \u1090 \u1100 \u1089 \u1103  \u1079 \u1072  \u1079 \u1072 \u1084 \u1086 \u1074 \u1095 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 \u1084 . \u1059 \u1084 \u1086 \u1074 \u1080 : \u1086 \u1073 '\u1108 \u1084  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1110 \u1074  \u1076 \u1086  6 \u1082 \u1075  \u1082 \u1072 \u1074 \u1080  \u1085 \u1072  \u1090 \u1080 \u1078 \u1076 \u1077 \u1085 \u1100 ; \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1103  \u1074 \u1086 \u1076 \u1080  \u1084 \u1077 \u1085 \u1096 \u1077  180ppm; \u1085 \u1077 \u1084 \u1072 \u1108  \u1082 \u1086 \u1084 \u1087 \u1077 \u1085 \u1089 \u1072 \u1094 \u1110 \u1111  \u1074 \u1086 \u1076 \u1080 ; \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103  \u1074 \u1110 \u1076 \u1087 \u1086 \u1074 \u1110 \u1076 \u1072 \u1108  \u1086 \u1073 '\u1108 \u1084 \u1091 ; \u1053 \u1077 \u1084 \u1072 \u1108  \u1076 \u1077 \u1073 \u1077 \u1090 \u1086 \u1074 \u1086 \u1111  \u1079 \u1072 \u1073 \u1086 \u1088 \u1075 \u1086 \u1074 \u1072 \u1085 \u1086 \u1089 \u1090 \u1110 .\\nPLATINUM - \u1094 \u1077  \u1058 \u1054 \u1055  \u1094 \u1110 \u1085 \u1072 , \u1097 \u1086  \u1074  \u1089 \u1077 \u1088 \u1077 \u1076 \u1085 \u1100 \u1086 \u1084 \u1091  \u1085 \u1072  5% \u1085 \u1080 \u1078 \u1095 \u1077  \u1094 \u1110 \u1085 \u1080  GOLD. \u1059 \u1084 \u1086 \u1074 \u1080 : \u1054 \u1073 '\u1108 \u1084  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1110 \u1074  \u1073 \u1110 \u1083 \u1100 \u1096 \u1077  6 \u1082 \u1075  \u1082 \u1072 \u1074 \u1080  \u1074  \u1090 \u1080 \u1078 \u1076 \u1077 \u1085 \u1100  \u1072 \u1073 \u1086  \u1084 \u1077 \u1088 \u1077 \u1078 \u1072  \u1074 \u1110 \u1076  3-\u1093  \u1090 \u1086 \u1088 \u1075 \u1086 \u1074 \u1080 \u1093  \u1090 \u1086 \u1095 \u1086 \u1082  \u1079  \u1086 \u1073 '\u1108 \u1084 \u1086 \u1084  \u1074 \u1110 \u1076  3-\u1093  \u1082 \u1075  \u1085 \u1072  1 \u1090 \u1086 \u1095 \u1082 \u1091 ; \u1053 \u1077 \u1084 \u1072 \u1108  \u1087 \u1088 \u1086 \u1089 \u1090 \u1088 \u1086 \u1095 \u1077 \u1085 \u1086 \u1111  \u1076 \u1077 \u1073 \u1077 \u1090 \u1086 \u1074 \u1086 \u1111  \u1079 \u1072 \u1073 \u1086 \u1088 \u1075 \u1086 \u1074 \u1072 \u1085 \u1086 \u1089 \u1090 \u1110 ; \u1042 \u1086 \u1076 \u1072  \u1084 \u1077 \u1085 \u1096 \u1077  180ppm; \u1042  \u1090 \u1086 \u1088 \u1075 \u1086 \u1074 \u1080 \u1093  \u1090 \u1086 \u1095 \u1082 \u1072 \u1093  \u1085 \u1072 \u1103 \u1074 \u1085 \u1072  \u1076 \u1086 \u1076 \u1072 \u1090 \u1082 \u1086 \u1074 \u1072  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1094 \u1110 \u1103  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1111  (\u1052 \u1077 \u1083 \u1077 \u1085 \u1072  \u1082 \u1072 \u1074 \u1072 , \u1053 \u1072 \u1090 \u1091 \u1088 \u1072 \u1083 \u1100 \u1085 \u1080 \u1081  \u1095 \u1072 \u1081 ). \u1044 \u1072 \u1085 \u1072  \u1094 \u1110 \u1085 \u1072  - \u1094 \u1077  \u1073 \u1086 \u1085 \u1091 \u1089  \u1074 \u1110 \u1076 \u1088 \u1072 \u1079 \u1091  \u1074  \u1095 \u1077 \u1082 \u1091 ! \u1042 \u1110 \u1076 \u1088 \u1072 \u1079 \u1091  5% \u1087 \u1088 \u1080  \u1086 \u1090 \u1088 \u1080 \u1084 \u1072 \u1085 \u1085 \u1110  \u1090 \u1086 \u1074 \u1072 \u1088 \u1091 , \u1085 \u1077  \u1095 \u1077 \u1088 \u1077 \u1079  3 \u1084 \u1110 \u1089 \u1103 \u1094 \u1110 , \u1072  \u1074 \u1110 \u1076 \u1088 \u1072 \u1079 \u1091 !\\nBLACK - \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1080 , \u1103 \u1082 \u1110  \u1084 \u1072 \u1102 \u1090 \u1100  \u1085 \u1080 \u1079 \u1100 \u1082 \u1080 \u1081  \u1086 \u1073 '\u1108 \u1084  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1110 \u1074  (\u1055 \u1088 \u1080 \u1082 \u1083 \u1072 \u1076 : Krea Touch- \u1076 \u1086  6 \u1082 \u1075 ; Korinto Prime - \u1076 \u1086  3 \u1082 \u1075 ; Korinto \'96 \u1076 \u1086  1.5 \u1082 \u1075 ); \u1057 \u1074 \u1110 \u1076 \u1086 \u1084 \u1086  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1102 \u1090 \u1100  \u1085 \u1077 \u1103 \u1082 \u1110 \u1089 \u1085 \u1091  \u1074 \u1086 \u1076 \u1091 ; \u1052 \u1072 \u1102 \u1090 \u1100  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1072 \u1090 \u1080 \u1095 \u1085 \u1091  \u1076 \u1077 \u1073 \u1077 \u1090 \