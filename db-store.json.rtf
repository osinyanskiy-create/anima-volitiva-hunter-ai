\u1096 \u1091  \u1082 \u1072 \u1074 \u1091  \u1089 \u1086 \u1073 \u1110  (\u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1082 \u1072  \u1089 \u1084 \u1072 \u1082 \u1091 /\u1090 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1080 ), \u1087 \u1086 \u1090 \u1110 \u1084  \u1087 \u1088 \u1080 \u1075 \u1086 \u1089 \u1090 \u1080 \u1090 \u1080  \u1051 \u1055 \u1056 /\u1087 \u1077 \u1088 \u1089 \u1086 \u1085 \u1072 \u1083 ; \u1087 \u1110 \u1076  \u1095 \u1072 \u1089  \u1076 \u1077 \u1075 \u1091 \u1089 \u1090 \u1072 \u1094 \u1110 \u1111  \u1087 \u1088 \u1086 \u1074 \u1077 \u1089 \u1090 \u1080  \u1087 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1110 \u1102 : \u1074 \u1080 \u1075 \u1086 \u1076 \u1080 ; \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1072 ; \u1086 \u1073 \u1086 \u1074 \'92\u1103 \u1079 \u1082 \u1086 \u1074 \u1086 : (\u1086 \u1073 \u1077 \u1088 \u1077 \u1078 \u1085 \u1086 ) \'93\u1095 \u1077 \u1088 \u1077 \u1079  2 \u1084 \u1110 \u1089 \u1103 \u1094 \u1110  \u1073 \u1091 \u1076 \u1077  \u1072 \u1085 \u1072 \u1083 \u1110 \u1079  \u1110  \u1084 \u1086 \u1078 \u1083 \u1080 \u1074 \u1110  \u1079 \u1084 \u1110 \u1085 \u1080 \'94.\\n\u1047 \u1072 \u1082 \u1088 \u1080 \u1090 \u1090 \u1103  \u1091 \u1075 \u1086 \u1076 \u1080 : \u1091 \u1079 \u1075 \u1086 \u1076 \u1080 \u1090 \u1080  \u1085 \u1072 \u1089 \u1090 \u1091 \u1087 \u1085 \u1080 \u1081  \u1082 \u1088 \u1086 \u1082 : \u1075 \u1088 \u1072 \u1092 \u1110 \u1082  \u1074 \u1110 \u1079 \u1080 \u1090 \u1110 \u1074  (\u1097 \u1086 \u1090 \u1080 \u1078 \u1085 \u1103 ), \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090  \u1076 \u1083 \u1103  \u1074 \u1080 \u1088 \u1110 \u1096 \u1077 \u1085 \u1085 \u1103  \u1087 \u1080 \u1090 \u1072 \u1085 \u1100  \u1087 \u1086  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1102 , \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1072  \u1086 \u1087 \u1083 \u1072 \u1090 \u1080 ; \u1079 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1087 \u1077 \u1088 \u1096 \u1091  \u1079 \u1072 \u1075 \u1088 \u1091 \u1079 \u1082 \u1091  + \u1076 \u1086 \u1076 \u1072 \u1090 \u1082 \u1086 \u1074 \u1091  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1094 \u1110 \u1102  (\u1095 \u1072 \u1081 /\u1084 \u1077 \u1083 \u1077 \u1085 \u1072  \u1082 \u1072 \u1074 \u1072 ) \u1110  \u1087 \u1088 \u1086 \u1076 \u1072 \u1090 \u1080  \u1086 \u1076 \u1088 \u1072 \u1079 \u1091 ; \u1087 \u1088 \u1086 \u1074 \u1077 \u1089 \u1090 \u1080  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1077  \u1085 \u1072 \u1074 \u1095 \u1072 \u1085 \u1085 \u1103  \u1087 \u1077 \u1088 \u1089 \u1086 \u1085 \u1072 \u1083 \u1091  (5\'967 \u1093 \u1074 ), \u1074 \u1080 \u1076 \u1072 \u1090 \u1080  \'93\u1096 \u1087 \u1072 \u1088 \u1075 \u1072 \u1083 \u1082 \u1091  \u1087 \u1086 \u1084 \u1080 \u1083 \u1086 \u1082 \'94, \u1079 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1085 \u1086 \u1084 \u1077 \u1088 .\\n\u1055 \u1088 \u1080 \u1082 \u1083 \u1072 \u1076  \u1053 \u1077 \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1086  (\u1103 \u1082  \u1074 \u1080 \u1085 \u1080 \u1082 \u1072 \u1108  \u1082 \u1086 \u1085 \u1092 \u1083 \u1110 \u1082 \u1090 ): \u1040 \u1075 \u1077 \u1085 \u1090  \u1074 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1080 \u1074  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090 , \u1088 \u1086 \u1079 \u1082 \u1072 \u1079 \u1072 \u1074  \u1090 \u1110 \u1083 \u1100 \u1082 \u1080  \'93\u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103  \u1073 \u1077 \u1079 \u1082 \u1086 \u1096 \u1090 \u1086 \u1074 \u1085 \u1086 , \u1084 \u1080  \u1087 \u1088 \u1080 \u1111 \u1078 \u1076 \u1078 \u1072 \u1108 \u1084 \u1086  \u1088 \u1072 \u1079  \u1085 \u1072  \u1090 \u1080 \u1078 \u1076 \u1077 \u1085 \u1100 \'94. \u1055 \u1088 \u1086  \u1084 \u1110 \u1085 \u1110 \u1084 \u1072 \u1083 \u1100 \u1085 \u1110  \u1086 \u1073 \'92\u1108 \u1084 \u1080  \u1110  \u1087 \u1077 \u1088 \u1077 \u1075 \u1083 \u1103 \u1076  \u1095 \u1077 \u1088 \u1077 \u1079  2 \u1084 \u1110 \u1089 \u1103 \u1094 \u1110  \'97 \u1087 \u1088 \u1086 \u1084 \u1086 \u1074 \u1095 \u1072 \u1074 . \u1063 \u1077 \u1088 \u1077 \u1079  8 \u1090 \u1080 \u1078 \u1085 \u1110 \u1074  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1110  \u1085 \u1080 \u1079 \u1100 \u1082 \u1110 . \u1050 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1103  \u1087 \u1077 \u1088 \u1077 \u1074 \u1086 \u1076 \u1080 \u1090 \u1100  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1072  \u1085 \u1072  \u1110 \u1085 \u1096 \u1110  \u1091 \u1084 \u1086 \u1074 \u1080  (\u1094 \u1110 \u1085 \u1072  \u1074 \u1080 \u1097 \u1072 /\u1110 \u1085 \u1096 \u1072  \u1084 \u1086 \u1076 \u1077 \u1083 \u1100 ). \u1050 \u1083 \u1110 \u1108 \u1085 \u1090 : \'93\u1042 \u1080  \u1084 \u1077 \u1085 \u1077  \u1086 \u1073 \u1084 \u1072 \u1085 \u1091 \u1083 \u1080 , \u1074 \u1080  \u1085 \u1077  \u1082 \u1072 \u1079 \u1072 \u1083 \u1080  \u1087 \u1088 \u1086  \u1087 \u1077 \u1088 \u1077 \u1075 \u1083 \u1103 \u1076  \u1094 \u1110 \u1085 \u1080  \u1095 \u1077 \u1088 \u1077 \u1079  \u1076 \u1074 \u1072  \u1084 \u1110 \u1089 \u1103 \u1094 \u1110 \'94 \u8594  \u1089 \u1074 \u1072 \u1088 \u1082 \u1072 , \u1085 \u1077 \u1075 \u1072 \u1090 \u1080 \u1074 , \u1088 \u1080 \u1079 \u1080 \u1082  \u1074 \u1090 \u1088 \u1072 \u1090 \u1080  \u1090 \u1086 \u1095 \u1082 \u1080 .\\n\u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1086  (\u1103 \u1082  \u1091 \u1085 \u1080 \u1082 \u1085 \u1091 \u1090 \u1080  \u1087 \u1088 \u1086 \u1073 \u1083 \u1077 \u1084 ): \u1059  \u1076 \u1077 \u1085 \u1100  \u1074 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1085 \u1103  \u1072 \u1075 \u1077 \u1085 \u1090  \u1082 \u1072 \u1078 \u1077 : \'93\u1052 \u1080  \u1089 \u1090 \u1072 \u1088 \u1090 \u1091 \u1108 \u1084 \u1086  \u1085 \u1072  \u1083 \u1086 \u1103 \u1083 \u1100 \u1085 \u1080 \u1093  \u1091 \u1084 \u1086 \u1074 \u1072 \u1093 , \u1072 \u1083 \u1077  \u1095 \u1077 \u1088 \u1077 \u1079  2 \u1084 \u1110 \u1089 \u1103 \u1094 \u1110  \u1076 \u1080 \u1074 \u1080 \u1084 \u1086 \u1089 \u1100  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1110 . \u1071 \u1082 \u1097 \u1086  \u1086 \u1073 \u1089 \u1103 \u1075 \u1080  \u1085 \u1077  \u1088 \u1086 \u1089 \u1090 \u1091 \u1090 \u1100  \'97 \u1091 \u1079 \u1075 \u1086 \u1076 \u1080 \u1084 \u1086  \u1086 \u1076 \u1080 \u1085  \u1110 \u1079  \u1074 \u1072 \u1088 \u1110 \u1072 \u1085 \u1090 \u1110 \u1074 : \u1110 \u1085 \u1096 \u1072  \u1094 \u1110 \u1085 \u1086 \u1074 \u1072  \u1082 \u1072 \u1090 \u1077 \u1075 \u1086 \u1088 \u1110 \u1103  / \u1086 \u1088 \u1077 \u1085 \u1076 \u1085 \u1072  \u1084 \u1086 \u1076 \u1077 \u1083 \u1100  / \u1074 \u1072 \u1096 \u1077  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103 . \u1071 \u1082 \u1097 \u1086  \u1086 \u1073 \u1089 \u1103 \u1075 \u1080  \u1074 \u1080 \u1089 \u1086 \u1082 \u1110  \'97 \u1084 \u1086 \u1078 \u1077 \u1084 \u1086  \u1087 \u1086 \u1082 \u1088 \u1072 \u1097 \u1080 \u1090 \u1080  \u1091 \u1084 \u1086 \u1074 \u1080 .\'94 \u1063 \u1077 \u1088 \u1077 \u1079  8 \u1090 \u1080 \u1078 \u1085 \u1110 \u1074  \u1090 \u1077 \u1084 \u1072  \u1085 \u1077  \u1085 \u1086 \u1074 \u1072 , \u1082 \u1083 \u1110 \u1108 \u1085 \u1090  \u1075 \u1086 \u1090 \u1086 \u1074 \u1080 \u1081 . \u1050 \u1086 \u1085 \u1092 \u1083 \u1110 \u1082 \u1090 \u1091  \u1085 \u1077 \u1084 \u1072 \u1108 .\\n(\u1030 \u1084 \'92\u1103 ), \u1084 \u1072 \u1102  \u1085 \u1072 \u1075 \u1086 \u1083 \u1086 \u1089 \u1080 \u1090 \u1080 : \u1084 \u1080  \u1079  \u1074 \u1072 \u1084 \u1080  \u1087 \u1088 \u1072 \u1094 \u1102 \u1108 \u1084 \u1086  \u1087 \u1086  \u1084 \u1086 \u1076 \u1077 \u1083 \u1110  \u1089 \u1091 \u1073 \u1086 \u1088 \u1077 \u1085 \u1076 \u1080  \'97 \u1090 \u1086 \u1073 \u1090 \u1086  \u1074 \u1080  \u1085 \u1077  \u1087 \u1083 \u1072 \u1090 \u1080 \u1090 \u1077  \u1079 \u1072  \u1086 \u1088 \u1077 \u1085 \u1076 \u1091  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103 , \u1085 \u1077  \u1090 \u1091 \u1088 \u1073 \u1091 \u1108 \u1090 \u1077 \u1089 \u1100  \u1087 \u1088 \u1086  \u1086 \u1073 \u1089 \u1083 \u1091 \u1075 \u1086 \u1074 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1081  \u1087 \u1086 \u1090 \u1086 \u1095 \u1085 \u1110  \u1088 \u1077 \u1084 \u1086 \u1085 \u1090 \u1080 , \u1072  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1108 \u1090 \u1077  \u1085 \u1072 \u1096 \u1110  \u1110 \u1085 \u1075 \u1088 \u1077 \u1076 \u1110 \u1108 \u1085 \u1090 \u1080  (\u1082 \u1072 \u1074 \u1072 , \u1084 \u1086 \u1083 \u1086 \u1082 \u1086 , \u1089 \u1080 \u1087 \u1091 \u1095 \u1082 \u1072 ). \u1053 \u1072 \u1090 \u1086 \u1084 \u1110 \u1089 \u1090 \u1100  \u1079  \u1074 \u1072 \u1096 \u1086 \u1075 \u1086  \u1073 \u1086 \u1082 \u1091  \'97 \u1076 \u1086 \u1086 \u1095 \u1080 \u1097 \u1077 \u1085 \u1072  \u1074 \u1086 \u1076 \u1072  \u1076 \u1086  180 ppm \u1110  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1110  \u1091 \u1084 \u1086 \u1074 \u1080  \u1076 \u1083 \u1103  \u1079 \u1073 \u1077 \u1088 \u1077 \u1078 \u1077 \u1085 \u1085 \u1103  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103 . \u1042  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090 \u1110  \'97 \u1090 \u1110 \u1083 \u1100 \u1082 \u1080  \u1085 \u1072 \u1096 \u1110  \u1110 \u1085 \u1075 \u1088 \u1077 \u1076 \u1110 \u1108 \u1085 \u1090 \u1080 . \u1062 \u1077  \u1085 \u1077  \'91\u1073 \u1072 \u1078 \u1072 \u1085 \u1086 \'92, \u1094 \u1077  \u1091 \u1084 \u1086 \u1074 \u1072 . \u1052 \u1080  \u1087 \u1088 \u1072 \u1094 \u1102 \u1108 \u1084 \u1086  \u1073 \u1077 \u1079  \u1076 \u1077 \u1073 \u1110 \u1090 \u1086 \u1088 \u1082 \u1080 . \u1050 \u1072 \u1074 \u1091  \'91\u1074  \u1073 \u1086 \u1088 \u1075 \'92 \u1085 \u1077  \u1079 \u1072 \u1083 \u1080 \u1096 \u1072 \u1108 \u1084 \u1086 . \u1054 \u1087 \u1083 \u1072 \u1090 \u1072 : \u1072 \u1073 \u1086  \u1075 \u1086 \u1090 \u1110 \u1074 \u1082 \u1072 , \u1072 \u1073 \u1086  \u1087 \u1077 \u1088 \u1077 \u1088 \u1072 \u1093 \u1091 \u1085 \u1086 \u1082  \u1074  \u1076 \u1077 \u1085 \u1100  \u1074 \u1110 \u1076 \u1074 \u1072 \u1085 \u1090 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103 ."\cf0 \cb1 \strokec3 \
