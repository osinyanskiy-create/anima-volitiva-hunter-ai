\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1054 \u1073 \u1086 \u1074 '\u1103 \u1079 \u1082 \u1086 \u1074 \u1072  \u1091 \u1084 \u1086 \u1074 \u1072 : \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1103  \u1076 \u1086 \u1086 \u1095 \u1080 \u1097 \u1077 \u1085 \u1086 \u1111  \u1074 \u1086 \u1076 \u1080  \u1076 \u1086  180 PPM \u1076 \u1083 \u1103  \u1082 \u1086 \u1084 \u1077 \u1088 \u1094 \u1110 \u1081 \u1085 \u1086 \u1075 \u1086  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103  \u1090 \u1072  \u1076 \u1086  100 PPM \u1076 \u1083 \u1103  \u1087 \u1088 \u1086 \u1092 \u1077 \u1089 \u1110 \u1081 \u1085 \u1086 \u1075 \u1086 .\\n\u1053 \u1072 \u1089 \u1083 \u1110 \u1076 \u1082 \u1080  \u1085 \u1077 \u1086 \u1095 \u1080 \u1097 \u1077 \u1085 \u1086 \u1111  \u1074 \u1086 \u1076 \u1080 :\\n\u1044 \u1083 \u1103  \u1089 \u1087 \u1086 \u1078 \u1080 \u1074 \u1072 \u1095 \u1072 : \u1079 \u1084 \u1110 \u1085 \u1102 \u1108 \u1090 \u1100 \u1089 \u1103  \u1089 \u1084 \u1072 \u1082  \u1085 \u1072 \u1087 \u1086 \u1102 , \u1085 \u1077  \u1087 \u1088 \u1086 \u1093 \u1086 \u1076 \u1080 \u1090 \u1100  \u1077 \u1082 \u1089 \u1090 \u1088 \u1072 \u1082 \u1094 \u1110 \u1103 , \u1084 \u1086 \u1078 \u1083 \u1080 \u1074 \u1072  \u1096 \u1082 \u1086 \u1076 \u1072  \u1079 \u1076 \u1086 \u1088 \u1086 \u1074 '\u1102  (\u1085 \u1072 \u1082 \u1080 \u1087 , \u1094 \u1074 \u1110 \u1083 \u1100 ).\\n\u1044 \u1083 \u1103  \u1058 \u1056 \u1058 : \u1079 \u1072 \u1090 \u1088 \u1080 \u1084 \u1082 \u1072  \u1088 \u1077 \u1084 \u1086 \u1085 \u1090 \u1091  (1-2 \u1076 \u1085 \u1110  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086 \u1102 ), \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1085 \u1110  \u1087 \u1086 \u1088 \u1091 \u1096 \u1077 \u1085 \u1085 \u1103  \u1087 \u1088 \u1080 \u1079 \u1074 \u1077 \u1076 \u1091 \u1090 \u1100  \u1076 \u1086  \u1087 \u1077 \u1088 \u1077 \u1075 \u1083 \u1103 \u1076 \u1091  \u1091 \u1084 \u1086 \u1074 .\\n\u1044 \u1083 \u1103  \u1050 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1111 : \u1088 \u1077 \u1084 \u1086 \u1085 \u1090  \u1086 \u1073 \u1093 \u1086 \u1076 \u1080 \u1090 \u1100 \u1089 \u1103  \u1091  5-7 \u1090 \u1080 \u1089 . \u1075 \u1088 \u1085 .\\n\u1044 \u1110 \u1111  \u1072 \u1075 \u1077 \u1085 \u1090 \u1072 :\\n\u1055 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1103 \u1090 \u1080  \u1074 \u1086 \u1076 \u1091  \u1087 \u1088 \u1080  \u1074 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1085 \u1110 . \u1055 \u1088 \u1080  \u1074 \u1080 \u1103 \u1074 \u1083 \u1077 \u1085 \u1085 \u1110  \u1087 \u1086 \u1088 \u1091 \u1096 \u1077 \u1085 \u1100  (\u1073 \u1110 \u1083 \u1100 \u1096 \u1077  180 PPM) \'97 \u1087 \u1086 \u1074 \u1110 \u1076 \u1086 \u1084 \u1080 \u1090 \u1080  \u1085 \u1072 \u1089 \u1083 \u1110 \u1076 \u1082 \u1080  \u1051 \u1055 \u1056 \u1091 , \u1076 \u1086 \u1073 \u1080 \u1090 \u1080 \u1089 \u1103  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1103  \u1086 \u1095 \u1080 \u1097 \u1077 \u1085 \u1086 \u1111  \u1074 \u1086 \u1076 \u1080 .\\n\u1042 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1074 \u1072 \u1090 \u1080  \u1090 \u1077 \u1093 \u1085 \u1110 \u1082 \u1091  \'ab\u1042 \u1080 \u1073 \u1110 \u1088  \u1073 \u1077 \u1079  \u1074 \u1080 \u1073 \u1086 \u1088 \u1091 \'bb (\'ab\u1059  \u1074 \u1072 \u1089  \u1108  \u1076 \u1077  \u1079 \u1072 \u1084 \u1086 \u1074 \u1080 \u1090 \u1080  \u1074 \u1086 \u1076 \u1091 , \u1095 \u1080  \u1076 \u1072 \u1090 \u1080  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090 \u1080  \u1085 \u1072 \u1096 \u1086 \u1075 \u1086  \u1087 \u1086 \u1089 \u1090 \u1072 \u1095 \u1072 \u1083 \u1100 \u1085 \u1080 \u1082 \u1072 ?\'bb).\\n\u1071 \u1082 \u1097 \u1086  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1091  \u1089 \u1087 \u1080 \u1089 \u1091 \u1102 \u1090 \u1100 \u1089 \u1103  \u1087 \u1086 \u1088 \u1094 \u1110 \u1111 , \u1085 \u1072 \u1075 \u1086 \u10