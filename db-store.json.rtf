\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1040 \u1088 \u1072 \u1073 \u1110 \u1082 \u1072  \u1110  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1072 : \u1088 \u1110 \u1079 \u1085 \u1080 \u1094 \u1103  \u1084 \u1110 \u1078  \u1076 \u1074 \u1086 \u1084 \u1072  \u1089 \u1086 \u1088 \u1090 \u1072 \u1084 \u1080  \u1082 \u1072 \u1074 \u1080 \\n\u1030 \u1079  \u1091 \u1089 \u1100 \u1086 \u1075 \u1086  \u1086 \u1073 \'92\u1108 \u1084 \u1091  \u1082 \u1072 \u1074 \u1080  \u1094 \u1080 \u1093  \u1076 \u1074 \u1086 \u1093  \u1074 \u1080 \u1076 \u1110 \u1074  \u1087 \u1088 \u1080 \u1073 \u1083 \u1080 \u1079 \u1085 \u1086  70% \u1087 \u1088 \u1080 \u1087 \u1072 \u1076 \u1072 \u1108  \u1089 \u1072 \u1084 \u1077  \u1085 \u1072  \u1072 \u1088 \u1072 \u1073 \u1110 \u1082 \u1091 , \u1072  30% \'97 \u1085 \u1072  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1091 .\\n\u1040 \u1088 \u1072 \u1073 \u1110 \u1082 \u1072 : \u1047 \u1077 \u1088 \u1085 \u1086  \u1072 \u1088 \u1072 \u1073 \u1110 \u1082 \u1080  \u1084 \u1110 \u1089 \u1090 \u1080 \u1090 \u1100  \u1074 \u1077 \u1083 \u1080 \u1082 \u1091  \u1082 \u1110 \u1083 \u1100 \u1082 \u1110 \u1089 \u1090 \u1100  \u1088 \u1110 \u1079 \u1085 \u1080 \u1093  \u1084 \u1072 \u1089 \u1077 \u1083 , \u1103 \u1082 \u1110  \u1084 \u1072 \u1102 \u1090 \u1100  \u1074  \u1089 \u1086 \u1073 \u1110  \u1072 \u1088 \u1086 \u1084 \u1072 \u1090 \u1080 \u1095 \u1085 \u1110  \u1088 \u1077 \u1095 \u1086 \u1074 \u1080 \u1085 \u1080 . \u1050 \u1086 \u1092 \u1077 \u1111 \u1085 \u1091  \u1074  \u1072 \u1088 \u1072 \u1073 \u1110 \u1094 \u1110  \u1084 \u1077 \u1085 \u1096 \u1077  \u1085 \u1110 \u1078  \u1074  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1110 , \u1074 \u1110 \u1085  \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1080 \u1090 \u1100  \u1087 \u1088 \u1080 \u1073 \u1083 \u1080 \u1079 \u1085 \u1086  0.9 \'96 2.0% (\u1074  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1110  1.8 \'96 4.0%). \u1040 \u1088 \u1072 \u1073 \u1110 \u1082 \u1091  \u1074 \u1080 \u1088 \u1086 \u1097 \u1091 \u1102 \u1090 \u1100  \u1091  \u1074 \u1080 \u1089 \u1086 \u1090 \u1085 \u1110 \u1081  \u1084 \u1110 \u1089 \u1094 \u1077 \u1074 \u1086 \u1089 \u1090 \u1110  \u1085 \u1072  \u1074 \u1080 \u1089 \u1086 \u1090 \u1110  \u1074 \u1110 \u1076  600 \u1076 \u1086  2000 \u1084 \u1077 \u1090 \u1088 \u1110 \u1074  \u1085 \u1072 \u1076  \u1088 \u1110 \u1074 \u1085 \u1077 \u1084  \u1084 \u1086 \u1088 \u1103 .\\n\u1056 \u1086 \u1073 \u1091 \u1089 \u1090 \u1072 : \u1044 \u1083 \u1103  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1080  \u1075 \u1086 \u1083 \u1086 \u1074 \u1085 \u1072  \u1091 \u1084 \u1086 \u1074 \u1072  \'97 \u1090 \u1077 \u1087 \u1083 \u1086 . \u1058 \u1086 \u1084 \u1091  \u1074 \u1086 \u1085 \u1072  \u1088 \u1086 \u1089 \u1090 \u1077  \u1083 \u1080 \u1096 \u1077  \u1074  \u1090 \u1088 \u1086 \u1087 \u1110 \u1082 \u1072 \u1093 . \u1056 \u1086 \u1073 \u1091 \u1089 \u1090 \u1072  \u1110 \u1076 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1087 \u1110 \u1076 \u1093 \u1086 \u1076 \u1080 \u1090 \u1100  \u1076 \u1083 \u1103  \u1077 \u1089 \u1087 \u1088 \u1077 \u1089 \u1086 , \u1076 \u1072 \u1102 \u1095 \u1080  \u1075 \u1091 \u1089 \u1090 \u1091  \u1087 \u1110 \u1085 \u1082 \u1091 . \u1050 \u1083 \u1072 \u1089 \u1080 \u1095 \u1085 \u1072  \u1110 \u1090 \u1072 \u1083 \u1110 \u1081 \u1089 \u1100 \u1082 \u1072  \u1082 \u1072 \u1074 \u1072  \'97 \u1094 \u1077  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1072  \u1089 \u1091 \u1084 \u1110 \u1096  \u1072 \u1088 \u1072 \u1073 \u1110 \u1082 \u1080  \u1090 \u1072  \u1088 \u1086 \u1073 \u1091 \u1089 \u1090 \u1080 .\\n\u1057 \u1090 \u1091 \u1087 \u1077 \u1085 \u1110  \u1086 \u1073 \u1078 \u1072 \u1088 \u1102 \u1074 \u1072 \u1085 \u1085 \u1103  \u1082 \u1072 \u1074 \u1080 :\\n\u1057 \u1074 \u1110 \u1090 \u1083 \u1077  (\u1089 \u1083 \u1072 \u1073 \u1082 \u1077 ) \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  (195-205\'b0\u1057 ) - \u1087 \u1086 \u1074 \u1085 \u1110 \u1089 \u1090 \u1102  \u1079 \u1073 \u1077 \u1088 \u1110 \u1075 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103  \u1073 \u1083 \u1072 \u1075 \u1086 \u1088 \u1086 \u1076 \u1085 \u1072  \u1082 \u1080 \u1089 \u1083 \u1080 \u1085 \u1082 \u1072 .\\n\u1057 \u1077 \u1088 \u1077 \u1076 \u1085 \u1108  \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  (210-220\'b0\u1057 ) - \u1084 \'92\u1103 \u1082 \u1080 \u1081  \u1089 \u1084 \u1072 \u1082  \u1110  \u1087 \u1086 \u1089 \u1083 \u1072 \u1073 \u1083 \u1077 \u1085 \u1072  \u1082 \u1080 \u1089 \u1083 \u1080 \u1085 \u1082 \u1072 , \u1089 \u1084 \u1072 \u1082  \u1082 \u1080 \u1089 \u1083 \u1086 -\u1089 \u1086 \u1083 \u1086 \u1076 \u1082 \u1080 \u1081 .\\n\u1058 \u1077 \u1084 \u1085 \u1077 , \u1072 \u1073 \u1086  \u1089 \u1080 \u1083 \u1100 \u1085 \u1077  \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  (220-230\'b0\u1057 ) - \u1084 \u1077 \u1085 \u1096 \u1077  \u1082 \u1080 \u1089 \u1083 \u1080 \u1085 \u1082 \u1080 , \u1085 \u1072 \u1073 \u1091 \u1074 \u1072 \u1102 \u1090 \u1100  \u1090 \u1077 \u1084 \u1085 \u1086 -\u1082 \u1086 \u1088 \u1080 \u1095 \u1085 \u1077 \u1074 \u1086 \u1075 \u1086  \u1082 \u1086 \u1083 \u1100 \u1086 \u1088 \u1091  \u1079 \u1110  \u1089 \u1083 \u1072 \u1073 \u1082 \u1080 \u1084 \u1080  \u1089 \u1083 \u1110 \u1076 \u1072 \u1084 \u1080  \u1084 \u1072 \u1089 \u1083 \u1103 \u1085 \u1080 \u1089 \u1090 \u1086 \u1089 \u1090 \u1110 .\\n\u1044 \u1091 \u1078 \u1077  \u1090 \u1077 \u1084 \u1085 \u1077  \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  (240-250\'b0\u1057 ) - \u1047 \u1077 \u1088 \u1085 \u1072  \u1074 \u1090 \u1088 \u1072 \u1095 \u1072 \u1102 \u1090 \u1100  \u1082 \u1080 \u1089 \u1083 \u1080 \u1085 \u1082 \u1091 , \u1089 \u1090 \u1072 \u1102 \u1090 \u1100  \u1084 \u1072 \u1089 \u1083 \u1103 \u1085 \u1080 \u1089 \u1090 \u1080 \u1084 \u1080  \u1110  \u1085 \u1072 \u1073 \u1091 \u1074 \u1072 \u1102 \u1090 \u1100  \u1082 \u1086 \u1083 \u1110 \u1088  \u1090 \u1077 \u1084 \u1085 \u1086 \u1075 \u1086  \u1096 \u1086 \u1082 \u1086 \u1083 \u1072 \u1076 \u1091 . \u1057 \u1084 \u1072 \u1082  \u1074 \u1080 \u1088 \u1072 \u1079 \u1085 \u1080 \u1081 , \u1075 \u1110 \u1088 \u1082 \u1080 \u1081  \u1110  \u1085 \u1072 \u1074 \u1110 \u1090 \u1100  \u1079 \u1083 \u1077 \u1075 \u1082 \u1072  \'ab\u1087 \u1072 \u1083 \u1077 \u1085 \u1080 \u1081 \'bb. \u1050 \u1072 \u1074 \u1091  \u1090 \u1077 \u1084 \u1085 \u1086 \u1075 \u1086  \u1086 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1102 \u1090 \u1100  \u1074  \u1030 \u1090 \u1072 \u1083 \u1110 \u1111  \u1076 \u1083 \u1103  \u1087 \u1088 \u1080 \u1075 \u1086 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1077 \u1089 \u1087 \u1088 \u1077 \u1089 \u1089 \u1086 .\\n\u1042 \u1080 \u1089 \u1085 \u1086 \u1074 \u1086 \u1082 : \u1052 \u1080  \u1087 \u1086 \u1088 \u1110 \u1074 \u1085 \u1102 \u1108 \u1084 \u1086  \u1074 \u1080 \u1073 \u1110 \u1088  \u1089 \u1086 \u1088 \u1090 \u1110 \u1074  \u1082 \u1072 \u1074 \u1080  \u1079  \u1074 \u1080 \u1073 \u1086 \u1088 \u1086 \u1084  \u1084 '\u1103 \u1089 \u1072  \u1076 \u1083 \u1103  \u1073 \u1086 \u1088 \u1097 \u1091 . \u1054 \u1073 \u1089 \u1084 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  (\'ab\u1058 \u1077 \u1084 \u1085 \u1077  \u1030 \u1090 \u1072 \u1083 \u1110 \u1081 \u1089 \u1100 \u1082 \u1077 \'bb) \'96 \u1094 \u1077  \u1085 \u1110 \u1073 \u1080  \u1095 \u1072 \u1089  \u1087 \u1088 \u1080 \u1075 \u1086 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1073 \u1091 \u1083 \u1100 \u1081 \u1086 \u1085 \u1091 . \u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1077  \u1085 \u1072 \u1083 \u1072 \u1096 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103  \'96 \u1094 \u1077  \u1103 \u1082  \u1074 \u1080 \u1073 \u1110 \u10