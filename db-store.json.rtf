\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1056 \u1086 \u1079 \u1096 \u1080 \u1088 \u1077 \u1085 \u1080 \u1081  \u1089 \u1082 \u1088 \u1080 \u1087 \u1090  \u1076 \u1083 \u1103  \u1090 \u1086 \u1088 \u1075 \u1086 \u1074 \u1086 \u1075 \u1086  \u1072 \u1075 \u1077 \u1085 \u1090 \u1072 : \u1047 \u1072 \u1083 \u1091 \u1095 \u1077 \u1085 \u1085 \u1103  \u1085 \u1086 \u1074 \u1086 \u1111  \u1090 \u1086 \u1088 \u1075 \u1086 \u1074 \u1086 \u1111  \u1090 \u1086 \u1095 \u1082 \u1080  (\u1041 \u1110 \u1073 \u1083 \u1110 \u1103  \u1040 \u1075 \u1077 \u1085 \u1090 \u1072 )\\n\u1042 \u1089 \u1090 \u1091 \u1087 : \u1060 \u1110 \u1083 \u1086 \u1089 \u1086 \u1092 \u1110 \u1103  \u1090 \u1072  \u1052 \u1072 \u1081 \u1085 \u1076 \u1089 \u1077 \u1090  \u1058 \u1086 \u1088 \u1075 \u1086 \u1074 \u1086 \u1075 \u1086  \u1040 \u1075 \u1077 \u1085 \u1090 \u1072 \\n\u1058 \u1074 \u1086 \u1103  \u1092 \u1110 \u1083 \u1086 \u1089 \u1086 \u1092 \u1110 \u1103 : \u1058 \u1080  \u1085 \u1077  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1090 \u1086 \u1088 \u1075 \u1086 \u1074 \u1080 \u1081  \u1072 \u1075 \u1077 \u1085 \u1090 . \u1058 \u1080  \'97 \u1087 \u1072 \u1088 \u1090 \u1085 \u1077 \u1088  \u1090 \u1072  \u1082 \u1086 \u1085 \u1089 \u1091 \u1083 \u1100 \u1090 \u1072 \u1085 \u1090  \u1079  \u1088 \u1086 \u1079 \u1074 \u1080 \u1090 \u1082 \u1091  \u1082 \u1072 \u1074 \u1086 \u1074 \u1086 \u1075 \u1086  \u1073 \u1110 \u1079 \u1085 \u1077 \u1089 \u1091  \u1076 \u1083 \u1103  \u1089 \u1074 \u1086 \u1111 \u1093  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1110 \u1074 . \u1058 \u1074 \u1086 \u1103  \u1084 \u1077 \u1090 \u1072  \'97 \u1085 \u1077  \'ab\u1087 \u1088 \u1086 \u1076 \u1072 \u1090 \u1080 \'bb, \u1072  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1090 \u1080  \u1111 \u1093 \u1085 \u1100 \u1086 \u1084 \u1091  \u1073 \u1110 \u1079 \u1085 \u1077 \u1089 \u1091  \u1079 \u1072 \u1088 \u1086 \u1073 \u1083 \u1103 \u1090 \u1080  \u1073 \u1110 \u1083 \u1100 \u1096 \u1077 , \u1072  \u1111 \u1093 \u1085 \u1110 \u1084  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1072 \u1084  \'97 \u1086 \u1090 \u1088 \u1080 \u1084 \u1091 \u1074 \u1072 \u1090 \u1080  \u1079 \u1072 \u1076 \u1086 \u1074 \u1086 \u1083 \u1077 \u1085 \u1085 \u1103 . \u1052 \u1080  \u1089 \u1090 \u1074 \u1086 \u1088 \u1102 \u1108 \u1084 \u1086  \u1094 \u1110 \u1085 \u1085 \u1110 \u1089 \u1090 \u1100 , \u1072  \u1085 \u1077  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1087 \u1086 \u1089 \u1090 \u1072 \u1095 \u1072 \u1108 \u1084 \u1086  \u1090 \u1086 \u1074 \u1072 \u1088 . \u1058 \u1074 \u1110 \u1081  \u1084 \u1072 \u1081 \u1085 \u1076 \u1089 \u1077 \u1090 : \u1058 \u1080  \'97 \u1075 \u1086 \u1089 \u1087 \u1086 \u1076 \u1072 \u1088  \u1089 \u1074 \u1086 \u1108 \u1111  \u1090 \u1077 \u1088 \u1080 \u1090 \u1086 \u1088 \u1110 \u1111 . \u1044 \u1110 \u1081  \u1088 \u1110 \u1096 \u1091 \u1095 \u1077 , \u1085 \u1077  \u1095 \u1077 \u1082 \u1072 \u1081  \u1074 \u1082 \u1072 \u1079 \u1110 \u1074 \u1086 \u1082 . \u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'96 \u1094 \u1077  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086 ! \u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'97 \u1094 \u1077  \u1085 \u1077  \u1074 \u1110 \u1076 \u1084 \u1086 \u1074 \u1072 , \u1072  \u1079 \u1072 \u1087 \u1080 \u1090  \u1085 \u1072  \u1076 \u1086 \u1076 \u1072 \u1090 \u1082 \u1086 \u1074 \u1091  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1102 .\\n\u1041 \u1083 \u1086 \u1082  1: \u1055 \u1110 \u1076 \u1075 \u1086 \u1090 \u1086 \u1074 \u1082 \u1072  \u1076 \u1086  \u1074 \u1110 \u1079 \u1080 \u1090 \u1091  (\u1040 \u1085 \u1072 \u1083 \u1110 \u1079  \u1090 \u1072  \u1088 \u1086 \u1079 \u1074 \u1110 \u1076 \u1082 \u1072 )\\n\u1047 \u1072 \u1081 \u1076 \u1080  \u1087 \u1077 \u1088 \u1096 \u1080 \u1081  \u1088 \u1072 \u1079  \u1103 \u1082  \u1087 \u1086 \u1082 \u1091 \u1087 \u1077 \u1094 \u1100  \'97 \u1090 \u1077 \u1073 \u1077  \u1079 \u1091 \u1089 \u1090 \u1088 \u1110 \u1085 \u1091 \u1090 \u1100  \u1085 \u1077  \u1074 \u1110 \u1076 \u1084 \u1086 \u1074 \u1082 \u1072 \u1084 \u1080 , \u1072  \u1087 \u1086 \u1089 \u1084 \u1110 \u1096 \u1082 \u1086 \u1102 . \u1058 \u1080  \u1074 \u1078 \u1077  \u1079 \u1072 \u1083 \u1080 \u1096 \u1080 \u1074  \u1075 \u1088 \u1086 \u1096 \u1110  \u1074  \u1082 \u1072 \u1089 \u1110  \'97 \u1086 \u1090 \u1078 \u1077 , \u1090 \u1080  \u1085 \u1077  \u1087 \u1088 \u1086 \u1093 \u1072 \u1095 , \u1072  \u1087 \u1086 \u1082 \u1091 \u1087 \u1077 \u1094 \u1100 . \u1030 \u1076 \u1077 \u1085 \u1090 \u1080 \u1092 \u1110 \u1082 \u1072 \u1094 \u1110 \u1103  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1072 : \u1071 \u1082 \u1110  \u1089 \u1090 \u1072 \u1082 \u1072 \u1085 \u1095 \u1080 \u1082 \u1080  \u1074  \u1091 \u1088 \u1085 \u1110 ? \u1062 \u1077  [\u1085 \u1072 \u1079 \u1074 \u1072  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1072 ]? \u1047 \u1072 \u1074 \u1072 \u1083 \u1077 \u1085 \u1080 \u1081  \u1089 \u1084 \u1110 \u1090 \u1085 \u1080 \u1082  \u1079 \u1110  \u1089 \u1090 \u1072 \u1082 \u1072 \u1085 \u1095 \u1080 \u1082 \u1072 \u1084 \u1080  \'97 \u1095 \u1091 \u1076 \u1086 \u1074 \u1080 \u1081  \u1079 \u1085 \u1072 \u1082 . \u1071 \u1082 \u1072  \u1094 \u1110 \u1085 \u1072  \u1085 \u1072  \u1077 \u1089 \u1087 \u1088 \u1077 \u1089 \u1086 ? (\u1071 \u1082 \u1097 \u1086  \u1085 \u1080 \u1079 \u1100 \u1082 \u1072 , ~15 \u1075 \u1088 \u1085  \'97 \u1081 \u1084 \u1086 \u1074 \u1110 \u1088 \u1085 \u1086 , \u1087 \u1088 \u1072 \u1094 \u1102 \u1102 \u1090 \u1100  \u1085 \u1072  \u1086 \u1073 \u1086 \u1088 \u1086 \u1090 \u1110 ).\\n\u1041 \u1083 \u1086 \u1082  2: \u1055 \u1077 \u1088 \u1096 \u1080 \u1081  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090  (\u1042 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1085 \u1103  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090 \u1091  \u1079  \u1055 \u1056 \u1054 \u1044 \u1040 \u1042 \u1062 \u1045 \u1052 )\\n\u1044 \u1083 \u1103  \u1087 \u1086 \u1095 \u1072 \u1090 \u1082 \u1091  \u1076 \u1110 \u1072 \u1083 \u1086 \u1075 \u1091  (\u1110 \u1085 \u1090 \u1088 \u1080 \u1075 \u1072  + \u1082 \u1086 \u1084 \u1087 \u1083 \u1110 \u1084 \u1077 \u1085 \u1090 ): \'ab\u1044 \u1086 \u1073 \u1088 \u1086 \u1075 \u1086  \u1076 \u1085 \u1103 ! \u1042 \u1080  \u1090 \u1072 \u1082  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086  \u1087 \u1088 \u1072 \u1094 \u1102 \u1108 \u1090 \u1077 , \u1097 \u1086  \u1103  \u1081  \u1085 \u1077  \u1074 \u1089 \u1090 \u1080 \u1075  \u1087 \u1086 \u1076 \u1091 \u1084 \u1072 \u1090 \u1080  \'97 \u1074 \u1078 \u1077  \u1086 \u1073 \u1089 \u1083 \u1091 \u1075 \u1086 \u1074 \u1091 \u1102 \u1090 \u1100 .\'bb \'ab\u1044 \u1110 \u1074 \u1095 \u1072 \u1090 \u1072 , \u1076 \u1086 \u1073 \u1088 \u1086 \u1075 \u1086  \u1076 \u1085 \u1103 ! \u1040  \u1087 \u1088 \u1072 \u1074 \u1076 \u1091 , \u1097 \u1086  \u1082 \u1072 \u1078 \u1091 \u1090 \u1100 ? \u1050 \u1072 \u1078 \u1091 \u1090 \u1100 , \u1097 \u1086  \u1091  \u1074 \u1072 \u1096 \u1086 \u1084 \u1091  \u1084 \u1072 \u1075 \u1072 \u1079 \u1080 \u1085 \u1110  \u1085 \u1072 \u1081 \u1097 \u1080 \u1088 \u1110 \u1096 \u1110  \u1090 \u1072  \u1085 \u1072 \u1081 \u1075 \u1072 \u1088 \u1085 \u1110 \u1096 \u1110  \u1087 \u1088 \u1086 \u1076 \u1072 \u1074 \u1094 \u1110  \u1087 \u1088 \u1072 \u1094 \u1102 \u1102 \u1090 \u1100 !\'bb \'ab\u1044 \u1086 \u1073 \u1088 \u1080 \u1081  \u1076 \u1077 \u1085 \u1100 ! \u1044 \u1072 \u1081 \u1090 \u1077  \u1087 \u1083 \u1103 \u1096 \u1082 \u1091  \u1074 \u1086 \u1076 \u1080 , \u1073 \u1086  \u1103  \u1074 \u1078 \u1077  \u1103 \u1082  \u1082 \u1074 \u1110 \u1090 \u1082 \u1072  \u1073 \u1077 \u1079  \u1087 \u1086 \u1083 \u1080 \u1074 \u1091 .\'bb (\u1046 \u1072 \u1088 \u1090 -\u1082 \u1074 \u1110 \u1090 \u1082 \u1072 ). \u1047 \u1072 \u1074 \u1078 \u1076 \u1080  \u1097 \u1086 \u1089 \u1100  \u1082 \u1091 \u1087 \u1091 \u1081 \u1090 \u1077 ! \u1062 \u1077  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1080 \u1095 \u1085 \u1086  \u1089 \u1090 \u1072 \u1074 \u1080 \u1090 \u1100  \u1074 \u1072 \u1089  \u1091  \u1087 \u1086 \u1079 \u1080 \u1094 \u1110 \u1102  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1072 !!\\n\u1041 \u1083 \u1086 \u1082  3: \u1044 \u1088 \u1091 \u1075 \u1080 \u1081  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090  \u1085 \u1077 \u1092 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1072  \u1044 \u1045 \u1043 \u1059 \u1057 \u1058 \u1040 \u1062 \u1030 \u1071 \\n\u1055 \u1086 \u1079 \u1085 \u1072 \u1081 \u1086 \u1084 \u1080 \u1090 \u1080  \u1087 \u1088 \u1086 \u1076 \u1072 \u1074 \u1094 \u1103  \u1079  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1086 \u1084  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1111  \u1095 \u1077 \u1088 \u1077 \u1079  \u1076 \u1077 \u1075 \u1091 \u1089 \u1090 \u1072 \u1094 \u1110 \u1102 . \'ab\u1040  \u1093 \u1086 \u1095 \u1077 \u1090 \u1077  \u1103  \u1042 \u1072 \u1089  \u1079 \u1076 \u1080 \u1074 \u1091 \u1102 ?)) \u1059 \u1103 \u1074 \u1110 \u1090 \u1100 , \u1097 \u1086 \u1073  \u1089 \u1082 \u1072 \u1079 \u1072 \u1083 \u1080  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1080  \u1103 \u1082 \u1097 \u1086  \u1073 \u1080  \u1074 \u1086 \u1085 \u1080  \u1087 \u1080 \u1083 \u1080  \u1090 \u1072 \u1082 \u1091  \u1082 \u1072 \u1074 \u1091  \u1091  \u1074 \u1072 \u1089 ?\'bb ...\u1052 \u1080  \u1079 \u1072 \u1081 \u1084 \u1072 \u1108 \u1084 \u1086 \u1089 \u1103  \u1087 \u1088 \u1086 \u1076 \u1072 \u1078 \u1077 \u1084  \u1085 \u1072 \u1088 \u1082 \u1086 \u1090 \u1080 \u1082 \u1110 \u1074 ... (\u1087 \u1072 \u1091 \u1079 \u1072 , \u1087 \u1086 \u1089 \u1084 \u1110 \u1096 \u1082 \u1072 ) ...\u1040 \u1083 \u1077  \u1074 \u1086 \u1085 \u1080  \u1083 \u1077 \u1075 \u1072 \u1083 \u1100 \u1085 \u1110 . \u1052 \u1080  \'97 \u1082 \u1072 \u1074 \u1086 \u1074 \u1072  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1103 , \u1110  \u1085 \u1072 \u1096 \u1072  \u1082 \u1072 \u1074 \u1072  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1108  \u1079 \u1072 \u1083 \u1077 \u1078 \u1085 \u1110 \u1089 \u1090 \u1100 ... \u1075 \u1072 \u1088 \u1085 \u1080 \u1084  \u1085 \u1072 \u1089 \u1090 \u1088 \u1086 \u1108 \u1084 !\\n\u1041 \u1083 \u1086 \u1082  4: \u1042 \u1080 \u1103 \u1074 \u1083 \u1077 \u1085 \u1085 \u1103  \u1051 \u1055 \u1056  (\u1042 \u1083 \u1072 \u1089 \u1085 \u1080 \u1082 \u1072 )\\n\u1055 \u1110 \u1076 \u1082 \u1072 \u1078 \u1110 \u1090 \u1100 , \u1073 \u1091 \u1076 \u1100  \u1083 \u1072 \u1089 \u1082 \u1072 , \u1072  \u1103 \u1082  \u1079 \u1074 \u1072 \u1090 \u1080  \u1074 \u1083 \u1072 \u1089 \u1085 \u1080 \u1082 \u1072 ? \u1040  \u1082 \u1086 \u1083 \u1080  \u1074 \u1110 \u1085  \u1079 \u1072 \u1079 \u1074 \u1080 \u1095 \u1072 \u1081  \u1073 \u1091 \u1074 \u1072 \u1108  \u1085 \u1072  \u1090 \u1086 \u1095 \u1094 \u1110 ?\\n\u1041 \u1083 \u1086 \u1082  5: \u1054 \u1060 \u1030 \u1062 \u1030 \u1049 \u1053 \u1040  \u1087 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1110 \u1103  \u1090 \u1072  \u1076 \u1077 \u1075 \u1091 \u1089 \u1090 \u1072 \u1094 \u1110 \u1103  \u1076 \u1083 \u1103  \u1042 \u1051 \u1040 \u1057 \u1053 \u1048 \u1050 \u1040 \\n\u1044 \u1110 \u1072 \u1075 \u1085 \u1086 \u1089 \u1090 \u1080 \u1082 \u1072  \u1089 \u1084 \u1072 \u1082 \u1091 : \'ab\u1055 \u1077 \u1088 \u1096  \u1085 \u1110 \u1078  \u1103  \u1074 \u1072 \u1089  \u1087 \u1088 \u1080 \u1075 \u1086 \u1097 \u1091 , \u1076 \u1086 \u1079 \u1074 \u1086 \u1083 \u1100 \u1090 \u1077  \u1079 \u1072 \u1087 \u1080 \u1090 \u1072 \u1090 \u1080 : \u1103 \u1082 \u1091  \u1082 \u1072 \u1074 \u1091  \u1074 \u1080  \u1083 \u1102 \u1073 \u1080 \u1090 \u1077 ? \u1052 \u1110 \u1094 \u1085 \u1091 , \u1084 '\u1103 \u1082 \u1091 , \u1079  \u1075 \u1110 \u1088 \u1095 \u1080 \u1085 \u1082 \u1086 \u1102  \u1095 \u1080  \u1082 \u1080 \u1089 \u1083 \u1080 \u1085 \u1082 \u1086 \u1102 ?\'bb \u1054 \u1073 \u1086 \u1074 \'92\u1103 \u1079 \u1082 \u1086 \u1074 \u1086  \u1076 \u1072 \u1090 \u1080  \u1089 \u1087 \u1088 \u1086 \u1073 \u1091 \u1074 \u1072 \u1090 \u1080  \u1084 \u1110 \u1085  2 \u1088 \u1110 \u1079 \u1085 \u1080 \u1093  \u1089 \u1086 \u1088 \u1090 \u1072  \u1082 \u1072 \u1074 \u1080 . \'ab\u1054 \u1089 \u1100  \u1094 \u1077  \'97 \u1103 \u1082  \u1073 \u1110 \u1083 \u1080 \u1081  \u1093 \u1083 \u1110 \u1073 , \u1084 '\u1103 \u1082 \u1080 \u1081  \u1090 \u1072  \u1085 \u1110 \u1078 \u1085 \u1080 \u1081 . \u1040  \u1086 \u1089 \u1100  \u1094 \u1077  \'97 \u1103 \u1082  \u1095 \u1086 \u1088 \u1085 \u1080 \u1081 , \u1085 \u1072 \u1089 \u1080 \u1095 \u1077 \u1085 \u1080 \u1081  \u1090 \u1072  \u1079  \u1093 \u1072 \u1088 \u1072 \u1082 \u1090 \u1077 \u1088 \u1086 \u1084 .\'bb \u1060 \u1110 \u1085 \u1072 \u1085 \u1089 \u1086 \u1074 \u1072  \u1084 \u1086 \u1090 \u1080 \u1074 \u1072 \u1094 \u1110 \u1103 : \u1071 \u1082 \u1110 \u1089 \u1085 \u1072  \u1082 \u1072 \u1074 \u1072  \'97 \u1094 \u1077  \u1084 \u1072 \u1075 \u1085 \u1110 \u1090  \u1076 \u1083 \u1103  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1110 \u1074 . \u1057 \u1077 \u1088 \u1074 \u1110 \u1089  \u1090 \u1072  \u1085 \u1072 \u1076 \u1110 \u1081 \u1085 \u1110 \u1089 \u1090 \u1100 : \u1053 \u1072 \u1096 \u1072  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1103  \u1085 \u1072  \u1088 \u1080 \u1085 \u1082 \u1091  \u1074 \u1078 \u1077  10 \u1088 \u1086 \u1082 \u1110 \u1074 . \u1052 \u1080  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1091 \u1108 \u1084 \u1086  \u1087 \u1086 \u1074 \u1085 \u1080 \u1081  \u1089 \u1077 \u1088 \u1074 \u1110 \u1089  24/7.\\n\u1041 \u1083 \u1086 \u1082  6: \u1040 \u1088 \u1089 \u1077 \u1085 \u1072 \u1083  \u1074 \u1110 \u1076 \u1087 \u1086 \u1074 \u1110 \u1076 \u1077 \u1081  \u1085 \u1072  \u1082 \u1083 \u1102 \u1095 \u1086 \u1074 \u1110  \u1079 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103 \\n\u1050 \u1083 \u1102 \u1095 \u1086 \u1074 \u1072  \u1090 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 : \u1055 \u1086 \u1075 \u1086 \u1076 \u1100 \u1090 \u1077 \u1089 \u1100 ! \u1053 \u1110 \u1082 \u1086 \u1083 \u1080  \u1085 \u1077  \u1089 \u1087 \u1077 \u1088 \u1077 \u1095 \u1072 \u1081 \u1090 \u1077 \u1089 \u1100 . \u1055 \u1077 \u1088 \u1077 \u1074 \u1077 \u1076 \u1110 \u1090 \u1100  \u1092 \u1086 \u1082 \u1091 \u1089  \u1085 \u1072  \u1082 \u1110 \u1085 \u1094 \u1077 \u1074 \u1086 \u1075 \u1086  \u1087 \u1086 \u1082 \u1091 \u1087 \u1094 \u1103 . \u1055 \u1110 \u1076 \u1089 \u1080 \u1083 \u1100 \u1090 \u1077  \u1089 \u1074 \u1086 \u1102  \u1087 \u1088 \u1086 \u1087 \u1086 \u1079 \u1080 \u1094 \u1110 \u1102  \u1094 \u1110 \u1085 \u1085 \u1110 \u1089 \u1090 \u1102 . \u1047 \u1072 \u1082 \u1088 \u1080 \u1074 \u1072 \u1081 \u1090 \u1077  \u1085 \u1072  \u1076 \u1110 \u1102 .\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1044 \u1086  \u1085 \u1072 \u1089  \u1111 \u1079 \u1076 \u1103 \u1090 \u1100  \u1079  \u1059 \u1084 \u1072 \u1085 \u1110  \u1085 \u1072  \u1082 \u1072 \u1074 \u1091 !\'bb: \'ab\u1062 \u1077  \u1085 \u1077 \u1081 \u1084 \u1086 \u1074 \u1110 \u1088 \u1085 \u1086  \u1082 \u1088 \u1091 \u1090 \u1086 ! \u1057 \u1072 \u1084 \u1077  \u1090 \u1086 \u1084 \u1091  \u1103  \u1093 \u1086 \u1095 \u1091  \u1079 \u1072 \u1087 \u1088 \u1086 \u1087 \u1086 \u1085 \u1091 \u1074 \u1072 \u1090 \u1080  \u1074 \u1072 \u1084  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 , \u1103 \u1082 \u1080 \u1081  \u1087 \u1077 \u1088 \u1077 \u1074 \u1080 \u1097 \u1091 \u1108  \u1094 \u1110  \u1089 \u1090 \u1072 \u1085 \u1076 \u1072 \u1088 \u1090 \u1080 , \u1097 \u1086 \u1073  \u1076 \u1086  \u1074 \u1072 \u1089  \u1111 \u1079 \u1076 \u1080 \u1083 \u1080  \u1097 \u1077  \u1081  \u1079  \u1050 \u1080 \u1108 \u1074 \u1072 .\'bb\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1047 \u1084 \u1110 \u1085 \u1102 \u1074 \u1072 \u1090 \u1080  \u1085 \u1110 \u1095 \u1086 \u1075 \u1086  \u1085 \u1077  \u1093 \u1086 \u1095 \u1077 \u1084 \u1086 \'bb: \'ab\u1071  \u1074 \u1072 \u1089  \u1095 \u1091 \u1076 \u1086 \u1074 \u1086  \u1088 \u1086 \u1079 \u1091 \u1084 \u1110 \u1102 , \u1089 \u1090 \u1072 \u1073 \u1110 \u1083 \u1100 \u1085 \u1110 \u1089 \u1090 \u1100  \'97 \u1094 \u1077  \u1075 \u1086 \u1083 \u1086 \u1074 \u1085 \u1077 . \u1040 \u1083 \u1077  \u1097 \u1086 , \u1103 \u1082 \u1073 \u1080  \u1103  \u1074 \u1072 \u1084  \u1089 \u1082 \u1072 \u1079 \u1072 \u1074 , \u1097 \u1086  \u1084 \u1086 \u1078 \u1085 \u1072  \u1086 \u1090 \u1088 \u1080 \u1084 \u1091 \u1074 \u1072 \u1090 \u1080  \u1097 \u1077  \u1082 \u1088 \u1072 \u1097 \u1080 \u1081  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1110  \u1089 \u1077 \u1088 \u1074 \u1110 \u1089  \u1079 \u1072  \u1090 \u1110  \u1078  \u1089 \u1072 \u1084 \u1110  \u1075 \u1088 \u1086 \u1096 \u1110 ? \u1052 \u1080  \u1084 \u1086 \u1078 \u1077 \u1084 \u1086  \u1087 \u1086 \u1089 \u1090 \u1072 \u1074 \u1080 \u1090 \u1080  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090  \u1087 \u1086 \u1088 \u1091 \u1095 , \u1087 \u1088 \u1086 \u1090 \u1077 \u1089 \u1090 \u1091 \u1074 \u1072 \u1090 \u1080 .\'bb\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1059  \u1085 \u1072 \u1089  \u1074 \u1083 \u1072 \u1089 \u1085 \u1077  \u1086 \u1073 \u1083 \u1072 \u1076 \u1085 \u1072 \u1085 \u1085 \u1103 \'bb: \'ab\u1062 \u1077  \u1095 \u1091 \u1076 \u1086 \u1074 \u1086 . \u1040 \u1083 \u1077  \u1093 \u1090 \u1086  \u1081 \u1086 \u1075 \u1086  \u1086 \u1073 \u1089 \u1083 \u1091 \u1075 \u1086 \u1074 \u1091 \u1108 ? \u1061 \u1090 \u1086  \u1075 \u1072 \u1088 \u1072 \u1085 \u1090 \u1091 \u1108  \u1089 \u1084 \u1072 \u1082  \u1079 \u1072 \u1074 \u1090 \u1088 \u1072 ? \u1052 \u1080  \u1073 \u1077 \u1088 \u1077 \u1084 \u1086  \u1074 \u1077 \u1089 \u1100  \u1094 \u1077 \u1081  \u1075 \u1086 \u1083 \u1086 \u1074 \u1085 \u1080 \u1081  \u1073 \u1110 \u1083 \u1100  \u1085 \u1072  \u1089 \u1077 \u1073 \u1077 : \u1097 \u1086 \u1090 \u1080 \u1078 \u1085 \u1077 \u1074 \u1077  \u1085 \u1072 \u1083 \u1072 \u1096 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 , \u1095 \u1080 \u1089 \u1090 \u1082 \u1072 , \u1089 \u1077 \u1088 \u1074 \u1110 \u1089  24/7. \u1042 \u1080  \u1079 \u1072 \u1081 \u1084 \u1072 \u1108 \u1090 \u1077 \u1089 \u1100  \u1073 \u1110 \u1079 \u1085 \u1077 \u1089 \u1086 \u1084 , \u1072  \u1084 \u1080  \'97 \u1082 \u1072 \u1074 \u1086 \u1102 .\'bb\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1058 \u1091 \u1090  \u1087 \u1086 \u1088 \u1091 \u1095  \u1082 \u1072 \u1074 '\u1103 \u1088 \u1085 \u1103 \'bb: \'ab\u1040 \u1073 \u1089 \u1086 \u1083 \u1102 \u1090 \u1085 \u1086  \u1079 \u1075 \u1086 \u1076 \u1077 \u1085 . \u1061 \u1090 \u1086 \u1089 \u1100  \u1093 \u1086 \u1095 \u1077  \u1072 \u1090 \u1084 \u1086 \u1089 \u1092 \u1077 \u1088 \u1091  \u1110  20 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085  \u1089 \u1087 \u1086 \u1082 \u1086 \u1102  \u1074 \u1110 \u1085  \u1087 \u1110 \u1076 \u1077  \u1074  \u1082 \u1072 \u1074 \'92\u1103 \u1088 \u1085 \u1102 . \u1040  \u1093 \u1090 \u1086 \u1089 \u1100  \u1073 \u1110 \u1078 \u1080 \u1090 \u1100  \u1087 \u1086  \u1076 \u1086 \u1088 \u1086 \u1079 \u1110 , \u1093 \u1086 \u1095 \u1077  \u1074 \u1079 \u1103 \u1090 \u1080  \u1097 \u1086 \u1089 \u1100  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086 , \u1085 \u1077 \u1076 \u1086 \u1088 \u1086 \u1075 \u1086  \u1110  \u1090 \u1091 \u1090  \u1085 \u1072 \u1096  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090  \u1110 \u1076 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1079 \u1072 \u1082 \u1088 \u1080 \u1074 \u1072 \u1108  \u1087 \u1086 \u1090 \u1088 \u1077 \u1073 \u1091 .\'bb\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1059  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1077 \u1085 \u1090 \u1072  \u1094 \u1110 \u1085 \u1072  \u1085 \u1080 \u1078 \u1095 \u1072 \'bb: \'ab\u1062 \u1110 \u1085 \u1072  \u1094 \u1077  \u1083 \u1080 \u1096 \u1077  \u1095 \u1072 \u1089 \u1090 \u1080 \u1085 \u1072  \u1110 \u1089 \u1090 \u1086 \u1088 \u1110 \u1111 . \u1052 \u1080  \u1087 \u1088 \u1086 \u1076 \u1072 \u1108 \u1084 \u1086  \u1085 \u1077  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1082 \u1072 \u1074 \u1091 , \u1072  \u1075 \u1086 \u1090 \u1086 \u1074 \u1077  \u1073 \u1110 \u1079 \u1085 \u1077 \u1089 -\u1088 \u1110 \u1096 \u1077 \u1085 \u1085 \u1103 . \u1047 \u1072  \u1088 \u1072 \u1093 \u1091 \u1085 \u1086 \u1082  \u1073 \u1110 \u1083 \u1100 \u1096 \u1086 \u1075 \u1086  \u1087 \u1086 \u1090 \u1086 \u1082 \u1091  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1110 \u1074 , \u1074 \u1072 \u1096 \u1072  \u1095 \u1080 \u1089 \u1090 \u1072  \u1084 \u1072 \u1088 \u1078 \u1072  \u1079  \u1082 \u1086 \u1078 \u1085 \u1086 \u1111  \u1095 \u1072 \u1096 \u1082 \u1080  \u1073 \u1091 \u1076 \u1077  \u1074 \u1080 \u1097 \u1086 \u1102 . \u1050 \u1088 \u1072 \u1097 \u1077  \u1073 \u1091 \u1090 \u1080  \u1079 \u1072 \u1076 \u1086 \u1074 \u1086 \u1083 \u1077 \u1085 \u1080 \u1084  \u1079 \u1072  10 \u1075 \u1088 \u1080 \u1074 \u1077 \u1085 \u1100  \u1095 \u1080 \u1084  \u1073 \u1091 \u1090 \u1080  \u1086 \u1073 \u1084 \u1072 \u1085 \u1091 \u1090 \u1080 \u1084  \u1079 \u1072  7.\'bb\\n\u1047 \u1072 \u1087 \u1077 \u1088 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \'ab\u1055 \u1083 \u1072 \u1090 \u1103 \u1090 \u1100  \u1088 \u1077 \u1090 \u1088 \u1086 -\u1073 \u1086 \u1085 \u1091 \u1089 , \u1082 \u1086 \u1084 \u1087 \u1077 \u1085 \u1089 \u1091 \u1102 \u1090 \u1100  \u1074 \u1086 \u1076 \u1091 \'bb: \'ab\u1053 \u1072 \u1096 \u1072  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1110 \u1103  \u1074 \u1110 \u1076 \u1088 \u1072 \u1079 \u1091  \u1079 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1108  \u1089 \u1082 \u1080 \u1076 \u1082 \u1091  \u1074 \u1072 \u1084  \u1074  \u1094 \u1110 \u1085 \u1091  (\u1074 \u1110 \u1076 \u1088 \u1072 \u1079 \u1091  \u1074  \u1095 \u1077 \u1082 \u1091 ), \u1085 \u1077  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1095 \u1077 \u1082 \u1072 \u1090 \u1080  \u1090 \u1072  \u1082 \u1086 \u1085 \u1090 \u1088 \u1086 \u1083 \u1102 \u1074 \u1072 \u1090 \u1080  \u1074 \u1080 \u1087 \u1083 \u1072 \u1090 \u1091 .\'bb\\n\u1041 \u1083 \u1086 \u1082  7: \u1057 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1085 \u1103  WOW-\u1077 \u1092 \u1077 \u1082 \u1090 \u1091 \\n\'ab\u1062 \u1077  \u1085 \u1077  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1087 \u1086 \u1076 \u1072 \u1088 \u1091 \u1085 \u1086 \u1082 . \u1062 \u1077  \u1089 \u1080 \u1084 \u1074 \u1086 \u1083  \u1085 \u1072 \u1096 \u1086 \u1075 \u1086  \u1087 \u1072 \u1088 \u1090 \u1085 \u1077 \u1088 \u1089 \u1090 \u1074 \u1072 .\'bb (\u1044 \u1072 \u1088 \u1091 \u1108 \u1084 \u1086  \u1073 \u1088 \u1077 \u1085 \u1076 \u1086 \u1074 \u1072 \u1085 \u1091  \u1090 \u1077 \u1088 \u1084 \u1086 \u1082 \u1088 \u1091 \u1078 \u1082 \u1091 ).\\n\u1041 \u1083 \u1086 \u1082  9: \u1047 \u1072 \u1074 \u1077 \u1088 \u1096 \u1077 \u1085 \u1085 \u1103  \u1091 \u1075 \u1086 \u1076 \u1080 \\n\u1055 \u1088 \u1103 \u1084 \u1080 \u1081  \u1079 \u1072 \u1082 \u1083 \u1080 \u1082 : \'ab\u1053 \u1091  \u1097 \u1086 , \u1089 \u1090 \u1072 \u1074 \u1080 \u1084 \u1086 ?\'bb \u1058 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072  \u1058 \u1077 \u1089 \u1090 -\u1044 \u1088 \u1072 \u1081 \u1074 : \'ab\u1084 \u1080  \u1089 \u1090 \u1072 \u1074 \u1080 \u1084 \u1086  \u1074 \u1072 \u1084  \u1085 \u1072 \u1096  \u1072 \u1087 \u1072 \u1088 \u1072 \u1090  \u1085 \u1072  \u1090 \u1080 \u1078 \u1076 \u1077 \u1085 \u1100  \u1072 \u1073 \u1089 \u1086 \u1083 \u1102 \u1090 \u1085 \u1086  \u1073 \u1077 \u1079 \u1082 \u1086 \u1096 \u1090 \u1086 \u1074 \u1085 \u1086 . \u1042 \u1080  \u1087 \u1086 \u1087 \u1088 \u1072 \u1094 \u1102 \u1108 \u1090 \u1077 , \u1079 \u1073 \u1077 \u1088 \u1077 \u1090 \u1077  \u1074 \u1110 \u1076 \u1075 \u1091 \u1082 \u1080 .\'bb \u1042 \u1080 \u1090 \u1110 \u1089 \u1085 \u1077 \u1085 \u1085 \u1103  \u1082 \u1086 \u1085 \u1082 \u1091 \u1088 \u1