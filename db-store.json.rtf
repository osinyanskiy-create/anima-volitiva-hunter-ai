\cb2       \cf4 \strokec4 "content"\cf0 \strokec3 : \cf5 \strokec5 "\uc0\u1057 \u1087 \u1110 \u1083 \u1082 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1079  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1072 \u1084 \u1080  \'97 \u1086 \u1089 \u1085 \u1086 \u1074 \u1072  \u1073 \u1110 \u1079 \u1085 \u1077 \u1089 \u1091 . \u1053 \u1072 \u1081 \u1074 \u1072 \u1078 \u1083 \u1080 \u1074 \u1110 \u1096 \u1072  \u1083 \u1102 \u1076 \u1080 \u1085 \u1072  \'97 \u1094 \u1077  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 . \u1052 \u1077 \u1090 \u1072 : \u1079 \u1072 \u1083 \u1091 \u1095 \u1077 \u1085 \u1085 \u1103  \u1090 \u1072  \u1091 \u1090 \u1088 \u1080 \u1084 \u1072 \u1085 \u1085 \u1103 .\\n\u1058 \u1088 \u1080  \u1094 \u1110 \u1083 \u1110  \u1082 \u1086 \u1084 \u1091 \u1085 \u1110 \u1082 \u1072 \u1094 \u1110 \u1111 : \u1055 \u1110 \u1079 \u1085 \u1072 \u1074 \u1072 \u1083 \u1100 \u1085 \u1072  (\u1085 \u1086 \u1074 \u1110  \u1079 \u1085 \u1072 \u1085 \u1085 \u1103 ), \u1057 \u1087 \u1086 \u1085 \u1091 \u1082 \u1072 \u1083 \u1100 \u1085 \u1072  (\u1089 \u1090 \u1080 \u1084 \u1091 \u1083 \u1102 \u1074 \u1072 \u1085 \u1085 \u1103  \u1076 \u1110 \u1081 ), \u1045 \u1082 \u1089 \u1087 \u1088 \u1077 \u1089 \u1080 \u1074 \u1085 \u1072  (\u1077 \u1084 \u1086 \u1094 \u1110 \u1111 ).\\n\u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1072  \u1078 \u1080 \u1074 \u1086 \u1075 \u1086  \u1089 \u1087 \u1110 \u1083 \u1082 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 :\\n\u1058 \u1077 \u1088 \u1087 \u1110 \u1085 \u1085 \u1103 : \u1074 \u1084 \u1110 \u1085 \u1085 \u1103  \u1074 \u1087 \u1086 \u1088 \u1072 \u1090 \u1080 \u1089 \u1103  \u1079  \u1085 \u1077 \u1075 \u1072 \u1090 \u1080 \u1074 \u1086 \u1084 . \u1040 \u1075 \u1088 \u1077 \u1089 \u1080 \u1074 \u1085 \u1110  \u1089 \u1091 \u1087 \u1077 \u1088 \u1077 \u1095 \u1082 \u1080  \u1073 \u1077 \u1079 \u1075 \u1083 \u1091 \u1079 \u1076 \u1110 .\\n\u1042 \u1080 \u1088 \u1110 \u1096 \u1077 \u1085 \u1085 \u1103  \u1087 \u1088 \u1086 \u1073 \u1083 \u1077 \u1084 \u1080 : \u1087 \u1088 \u1086 \u1087 \u1086 \u1085 \u1091 \u1074 \u1072 \u1090 \u1080  \u1084 \u1072 \u1082 \u1089 \u1080 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086  \u1074 \u1110 \u1076 \u1087 \u1086 \u1074 \u1110 \u1076 \u1085 \u1077  \u1088 \u1110 \u1096 \u1077 \u1085 \u1085 \u1103  (\u1085 \u1072 \u1074 \u1110 \u1090 \u1100  \u1103 \u1082 \u1097 \u1086  \u1094 \u1077  \u1087 \u1088 \u1080 \u1085 \u1077 \u1089 \u1077  \u1084 \u1077 \u1085 \u1096 \u1077  \u1087 \u1086 \u1090 \u1086 \u1095 \u1085 \u1086 \u1075 \u1086  \u1087 \u1088 \u1080 \u1073 \u1091 \u1090 \u1082 \u1091 ).\\n\u1059 \u1074 \u1072 \u1075 \u1072 : \u1089 \u1083 \u1091 \u1093 \u1072 \u1090 \u1080  \u1110  \u1088 \u1086 \u1079 \u1087 \u1110 \u1079 \u1085 \u1072 \u1090 \u1080  \u1074 \u1088 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1072 . \u1042 \u1079 \u1072 \u1108 \u1084 \u1086 \u1076 \u1110 \u1103  \u1084 \u1072 \u1108  \u1073 \u1091 \u1090 \u1080  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086 \u1102  \u1090 \u1072  \u1103 \u1082 \u1110 \u1089 \u1085 \u1086 \u1102 .\\n\u1053 \u1077 \u1087 \u1077 \u1088 \u1077 \u1076 \u1073 \u1072 \u1095 \u1077 \u1085 \u1110  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1110 \u1111 : \u1072 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1089 \u1087 \u1110 \u1083 \u1082 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1091  \u1089 \u1082 \u1083 \u1072 \u1076 \u1085 \u1080 \u1093  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1110 \u1103 \u1093  (\'ab\u1044 \u1072 \u1081 \u1090 \u1077  \u1084 \u1077 \u1085 \u1110  \u1076 \u1077 \u1082 \u1110 \u1083 \u1100 \u1082 \u1072  \u1075 \u1086 \u1076 \u1080 \u1085 , \u1103  \u1076 \u1072 \u1084  \u1074 \u1080 \u1095 \u1077 \u1088 \u1087 \u1085 \u1091  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1102 \'bb).\\n\u1055 \u1086 \u1079 \u1080 \u1090 \u1080 \u1074 \u1085 \u1080 \u1081  \u1085 \u1072 \u1089 \u1090 \u1088 \u1110 \u1081 : \u1087 \u1088 \u1080 \u1073 \u1080 \